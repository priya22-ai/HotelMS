# =============================
# HotelM — Neon + Render Env Template
# Copy to .env (local) and set same vars in Render Dashboard → Environment
# =============================

# Neon Postgres — paste pooled or direct string from Neon Dashboard
# Example: postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional: direct URL if you use pooled as DATABASE_URL, keep direct for migrations
# DIRECT_URL=postgres://...

# Server
PORT=3000
NODE_ENV=production
SESSION_SECRET=change_this_to_a_random_32_char_string
CLIENT_URL=http://localhost:5173

# For local dev: which DB to use (neon)
# PGSSL=require
